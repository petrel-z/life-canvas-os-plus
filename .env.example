# 复制为仓库根目录 .env，填写本机配置；此文件只含占位符。
# 后端按固定绝对位置读取根 .env，进程环境变量优先。
APP_ENV=development

# 仅服务端使用；不要复制到 VITE_* / EXPO_PUBLIC_* 等公开变量。
# 密码中的 @、/、# 等字符须进行 URL 编码。
DATABASE_URL=postgresql+psycopg://life_canvas:CHANGE_ME@127.0.0.1:54322/life_canvas

# JSON 数组，仅填写明确的 http(s) origin；不支持 * 或带路径的地址。
# 已接入 CORS 中间件。省略时不允许跨域来源。
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# S05 迁移使用单独的服务端角色与连接；当前尚不读取此变量。
# MIGRATION_DATABASE_URL=postgresql+psycopg://life_canvas_migrator:CHANGE_ME@127.0.0.1:54322/life_canvas

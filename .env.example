# 复制为仓库根目录 .env，填写本机配置；此文件只含占位符。
# 后端按固定绝对位置读取根 .env，进程环境变量优先。
APP_ENV=development

# 本机 PostgreSQL Compose；密码自行生成，禁止沿用占位符。
POSTGRES_USER=life_canvas_bootstrap
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=life_canvas

# 仅服务端使用；不要复制到 VITE_* / EXPO_PUBLIC_* 等公开变量。
# 与上方用户、密码及库名对应；URL 密码中的 @、/、#、% 等须编码。
# S05 本机暂用 bootstrap 角色；受限运行角色与 RLS 在 T2 落地。
DATABASE_URL=postgresql+psycopg://life_canvas_bootstrap:CHANGE_ME@127.0.0.1:54322/life_canvas

# 迁移独立读取此变量，不回退 DATABASE_URL；生产迁移与运行凭据必须分开。
MIGRATION_DATABASE_URL=postgresql+psycopg://life_canvas_bootstrap:CHANGE_ME@127.0.0.1:54322/life_canvas

# 集成测试控制连接：需 CREATEDB；只在随机临时库内迁移，测试后删除该临时库。
TEST_DATABASE_URL=postgresql+psycopg://life_canvas_bootstrap:CHANGE_ME@127.0.0.1:54322/postgres

# JSON 数组，仅填写明确的 http(s) origin；不支持 * 或带路径的地址。
# 已接入 CORS 中间件。省略时不允许跨域来源。
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
